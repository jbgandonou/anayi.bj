# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/anayi_db"

# JWT
JWT_SECRET="votre-secret-jwt-unique-a-changer"
JWT_REFRESH_SECRET="votre-secret-refresh-unique-a-changer"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Upload de fichiers
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Google OAuth
GOOGLE_CLIENT_ID="votre-google-client-id"

# Serveur
PORT=3000
